<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ClockTimer"
    android:background="#f4f8fa">

    <!-- Timer Mode Toggle Buttons - Rotated and on top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="200dp"
        android:paddingBottom="16dp"
        android:rotation="90">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/timerModeToggleGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:selectionRequired="true"
            app:singleSelection="true"
            app:checkedButton="@id/clockBtn">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clockBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Clock"
                app:strokeColor="@color/selector_toggle_button_stroke"
                app:strokeWidth="1dp"
                app:backgroundTint="@color/selector_toggle_button_background"
                android:textColor="@color/selector_toggle_button_text"/>  <!-- Default selected -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pomodoroButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Focus25"
                app:strokeColor="@color/selector_toggle_button_stroke"
                app:strokeWidth="1dp"
                app:backgroundTint="@color/selector_toggle_button_background"
                android:textColor="@color/selector_toggle_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startFromZeroButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Focusnow"
                app:strokeColor="@color/selector_toggle_button_stroke"
                app:strokeWidth="1dp"
                app:backgroundTint="@color/selector_toggle_button_background"
                android:textColor="@color/selector_toggle_button_text"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Clock container -->
        <LinearLayout
            android:id="@+id/clock_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Left Container - Hours & Date -->
            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:background="@drawable/hour_container_bg"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Hours Display -->
                <TextView
                    android:id="@+id/hoursText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="11"
                    android:textColor="#000000"
                    android:textSize="96sp" />

                <!-- Date Display -->
                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="June 15, 2023"
                    android:textColor="#1e2f67"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Right Container - Minutes & Day -->
            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:background="@drawable/minute_container_bg"
                android:gravity="center"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Minutes Display -->
                <TextView
                    android:id="@+id/minutesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="45"
                    android:textColor="#000000"
                    android:textSize="96sp" />

                <!-- Day Display -->
                <TextView
                    android:id="@+id/dayInfoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Friday"
                    android:textColor="#1e2f67"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/secondsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="00"
                    android:textColor="#1e2f67"
                    android:textSize="18sp"
                    android:layout_gravity="bottom"
                    android:gravity="bottom"/>  <!-- Align text inside TextView -->
            </LinearLayout>

        </LinearLayout>

        <!-- Button Container -->
        <LinearLayout
            android:id="@+id/button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="#4CAF50"
                android:elevation="4dp"
                android:text="Start"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="#F44336"
                android:elevation="4dp"
                android:text="Reset"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!--Bottom Navigation Bar-->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--Hidden sub-options-->
        <Button
            android:id="@+id/searchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/home"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageButton
            android:id="@+id/clockButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/clock"
            android:background="#529ad9"/>

        <ImageButton
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/user"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>